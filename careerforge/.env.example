# Public (safe for the browser). Find both in Supabase > Project Settings > API.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# Server-side only (Edge Function secrets). NEVER prefix with VITE_.
# AI_PROVIDER=mock
# AI_API_KEY=
# Set to true only AFTER deploying the career-analysis Edge Function and setting its secrets (see README). When false, the app runs in labelled demo mode.
VITE_AI_ENABLED=false
